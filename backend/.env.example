# Copy this file to backend/.env for local development.
# Keep backend/.env private. Never commit real tokens.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Optional: fine-grained GitHub token restricted to the target repository
# with Contents: Read and write permission. Required only when the
# "Publish verified fix to a new GitHub branch" option is enabled.
GITHUB_TOKEN=replace_with_your_github_token
